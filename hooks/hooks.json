{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${PLUGIN_ROOT}/scripts/plan_artifacts.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${PLUGIN_ROOT}/scripts/plan_artifacts.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "request_user_input",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${PLUGIN_ROOT}/scripts/plan_artifacts.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "request_user_input",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${PLUGIN_ROOT}/scripts/plan_artifacts.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${PLUGIN_ROOT}/scripts/plan_artifacts.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
